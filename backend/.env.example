# BRAINSERVE LOCAL BACKEND ENVIRONMENT
# File location: backend/.env
# DO NOT COMMIT THIS FILE.
# Replace every CHANGE_ME value before startup.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5433/brainserve
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=BrainServe_Redis@2026
REDIS_TIMEOUT=2s

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=brainserve.internal-calls.v1

# Local Mailpit
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=noreply@brainserve.in

# Browser/frontend connection
FRONTEND_PUBLIC_URL=http://localhost:5173
BRAIN_SERVE_ALLOWED_ORIGINS=http://localhost:5173
OFFICE_TIME_ZONE=Asia/Kolkata

# Required application secrets
JWT_SECRET=YxJ3u9vP2Lq7RmK5dF8nC4sW6aT1eH0bGzUoXiNkQpE=
PII_ENCRYPTION_KEY=K8mV4zQ1cN7yB2pR9xD5fW0uL6sA3hTjEoGiUkXnZqM=
QR_PASS_SIGNING_SECRET=BsQrPass-2026-Local-Key-9K4m2P7x8V1c6N5d

# System Admin bootstrap
SYSTEM_ADMIN_EMAIL=jetychodipilli@gmail.com
SYSTEM_ADMIN_DEFAULT_PASSWORD=SystemAdmin@BrainServe#06
SYSTEM_ADMIN_BOOTSTRAP_ENABLED=true

# CEO bootstrap
CEO_BOOTSTRAP_ENABLED=true
CEO_BOOTSTRAP_NAME=BrainServe CEO
CEO_BOOTSTRAP_EMAIL=manisaran@brainserve.in
CEO_BOOTSTRAP_PASSWORD=ManiSaran@BS#id06

# Identity and retention
COMPANY_EMAIL_DOMAIN=brainserve.in
SUPPORT_EMAIL=support@brainserve.in
ACCOUNT_ARCHIVE_RETENTION_YEARS=7
ACCOUNT_ARCHIVE_OTP_MINUTES=10
ACCOUNT_ARCHIVE_OTP_RESEND_SECONDS=60
ACCOUNT_ARCHIVE_OTP_MAX_ATTEMPTS=5
ADMIN_PASSWORD_VERIFICATION_LOCK_MINUTES=15
ACCOUNT_CLOSURE_CRON=0 5 0 * * *

# Reporting/archive encryption
ARCHIVE_ENCRYPTION_KEYS=v1=Q7mK2xN9pL4vR8cT1yH6dF3sW0aB5gJzUeIoXnMqPkA=
ARCHIVE_ENCRYPTION_ACTIVE_KEY_VERSION=v1
DASHBOARD_CACHE_SECONDS=180
REPORT_EXPORT_RETENTION_DAYS=7
REPORT_EXPORT_MAX_ROWS=1000000
PARTITION_ARCHIVE_ENABLED=true
PARTITION_CLEANUP_ENABLED=true
BACKUP_LIFECYCLE_RETENTION_DAYS=35

# Local MinIO / S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=brainserveadmin
S3_SECRET_KEY=BrainServeMinio@2026

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
